# Cấu hình máy chủ CINEMAX
PORT=3000
NODE_ENV=development

# Cấu hình Realtime Giữ ghế
HOLD_DURATION_MINUTES=10
CLEANING_BUFFER_MINUTES=15
LOYALTY_POINTS_RATE=0.05

# Cấu hình kết nối Supabase / PostgreSQL (Khi triển khai đám mây)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATABASE_URL=postgresql://postgres:password@localhost:5432/cinemax_db
